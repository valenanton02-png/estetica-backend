generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nombre   String
  usuario  String @unique
  password String
  rol      String @default("recepcionista")
}

model Servicio {
  id          Int      @id @default(autoincrement())
  nombre      String
  precio      Float
  duracionMin Int
  descripcion String?
  citas       Cita[]
  paquetes    PaquetePaciente[] // <--- ESTA ES LA LÍNEA MÁGICA QUE FALTABA
}

model Cliente {
  id                 Int      @id @default(autoincrement())
  nombre             String
  cedula             String   @unique
  telefono           String?
  edad               Int?
  alergias           String?
  condiciones        String?
  notas              String?
  fechaNacimiento    String?  // <--- ¡El signo de interrogación "?" arregla el error!
  deuda              Float    @default(0)
  saldoFavor         Float    @default(0)
  descuentoFijo      Int      @default(0)       
  citas              Cita[]
  paquetesActivos    PaquetePaciente[]          
}
model Cita {
  id            Int      @id @default(autoincrement())
  fecha         String   
  hora          String   
  tipo          String   
  estado        String   @default("Pendiente") 
  
  clienteId     Int
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  
  servicioId    Int
  servicio      Servicio @relation(fields: [servicioId], references: [id])

  sesionActual  Int?
  totalSesiones Int?
  extras        String?

  // --- CAMPOS DE CAJA Y FINANZAS ---
  metodoPago    String?  
  montoPagado   Float?   
}
model Inventario {
  id            Int     @id @default(autoincrement())
  nombre        String
  cantidad      Float
  unidad        String  // Ej: "potes", "ml", "unidades"
  stockMinimo   Float   // Para que la app sepa cuándo avisarte
}

model Egreso {
  id            Int     @id @default(autoincrement())
  fecha         String
  concepto      String
  categoria     String
  montoUSD      Float
}
// ==========================================
// MÓDULO BOUTIQUE (PRODUCTOS DE VENTA)
// ==========================================

model ProductoBoutique {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float    // Precio de venta al público
  stock       Int      // Cantidad disponible para vender
  ventas      VentaBoutique[]
}

model VentaBoutique {
  id                 Int      @id @default(autoincrement())
  fecha              String
  productoId         Int
  producto           ProductoBoutique @relation(fields: [productoId], references: [id])
  cantidad           Int
  totalPagado        Float
  metodoPago         String
}
// ==========================================
// MÓDULO ARQUEO DE CAJA (CUADRE DIARIO)
// ==========================================
model CajaDiaria {
  id                  Int      @id @default(autoincrement())
  fecha               String   @unique
  montoApertura       Float    // Dinero base en físico al abrir el local
  ingresosCalculados  Float?   // Lo que el sistema sumó en el día
  egresosCalculados   Float?   // Lo que se gastó en el día
  montoCierreFisico   Float?   // El billete real contado con las manos al irse
  diferencia          Float?   // Sobrante (+) o Faltante (-)
  estado              String   @default("Abierta") // "Abierta" o "Cerrada"
}
// ==========================================
// MÓDULO PAQUETES FLEXIBLES (ACUMULADORES)
// ==========================================
model PaquetePaciente {
  id                Int      @id @default(autoincrement())
  fechaCompra       String
  clienteId         Int
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  servicioId        Int
  servicio          Servicio @relation(fields: [servicioId], references: [id])
  totalSesiones     Int      // Ej. 10 sesiones
  sesionesUsadas    Int      @default(0) // Contador que irá subiendo
  precioTotal       Float    // Cuánto costó el paquete completo
  estadoPago        String   // "Pagado" o "Por Pagar" (El acumulador)
  estadoPaquete     String   @default("Activo") // "Activo" o "Completado"
}
