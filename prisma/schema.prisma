generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       Int    @id @default(autoincrement())
  nombre   String
  usuario  String @unique
  password String
  rol      String @default("recepcionista")
}

model Servicio {
  id          Int               @id @default(autoincrement())
  nombre      String
  precio      Float
  duracionMin Int?
  descripcion String?
  citas       Cita[]
  paquetes    PaquetePaciente[] 
}

model Cliente {
  id              Int               @id @default(autoincrement())
  nombre          String
  cedula          String            @unique
  telefono        String?
  fechaNacimiento String?
  edad            Int?              // <--- AÑADIDO: Edad de la paciente
  alergias        String?           // <--- AÑADIDO: Alergias
  condiciones     String?           // <--- AÑADIDO: Condiciones médicas
  notas           String?           // <--- AÑADIDO: Notas clínicas
  deuda           Float             @default(0)
  saldoFavor      Float             @default(0)       
  descuentoFijo   Int               @default(0)       
  citas           Cita[]
  paquetesActivos PaquetePaciente[]          
}

model Cita {
  id            Int      @id @default(autoincrement())
  fecha         String
  hora          String?
  estado        String   @default("Pendiente")
  tipo          String   @default("unica")
  sesionActual  Int?
  totalSesiones Int?
  extras        String?
  cargoSesion   Float?   

  metodoPago    String?
  montoPagado   Float?

  clienteId     Int
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  servicioId    Int
  servicio      Servicio @relation(fields: [servicioId], references: [id])
}

model Inventario {
  id          Int    @id @default(autoincrement())
  nombre      String
  cantidad    Float
  unidad      String  
  stockMinimo Float   
}

model Egreso {
  id        Int    @id @default(autoincrement())
  fecha     String
  concepto  String
  categoria String
  montoUSD  Float
}

// ==========================================
// MÓDULO BOUTIQUE (PRODUCTOS DE VENTA)
// ==========================================

model ProductoBoutique {
  id          Int             @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Float    
  stock       Int      
  ventas      VentaBoutique[]
}

model VentaBoutique {
  id          Int              @id @default(autoincrement())
  fecha       String
  productoId  Int
  producto    ProductoBoutique @relation(fields: [productoId], references: [id])
  cantidad    Int
  totalPagado Float
  metodoPago  String
}

// ==========================================
// MÓDULO ARQUEO DE CAJA (CUADRE DIARIO)
// ==========================================

model CajaDiaria {
  id                 Int      @id @default(autoincrement())
  fecha              String   @unique
  montoApertura      Float    
  ingresosCalculados Float?   
  egresosCalculados  Float?   
  montoCierreFisico  Float?   
  diferencia         Float?   
  estado             String   @default("Abierta") 
}

// ==========================================
// MÓDULO PAQUETES FLEXIBLES (ACUMULADORES)
// ==========================================

model PaquetePaciente {
  id             Int      @id @default(autoincrement())
  fechaCompra    String
  clienteId      Int
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  servicioId     Int
  servicio       Servicio @relation(fields: [servicioId], references: [id])
  totalSesiones  Int      
  sesionesUsadas Int      @default(0) 
  precioTotal    Float    
  estadoPago     String   
  estadoPaquete  String   @default("Activo") 
}

// ==========================================
// MÓDULO INGRESOS EXTRAS (NUEVO)
// ==========================================

model IngresoExtra {
  id         Int     @id @default(autoincrement())
  concepto   String
  monto      Float
  metodoPago String
  fecha      String
  hora       String?
}
